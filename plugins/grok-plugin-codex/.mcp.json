{
  "mcpServers": {
    "grok-plugin-codex": {
      "title": "Grok for Codex",
      "description": "Operate Grok CLI with explicit workspace scope and private restart-safe background jobs.",
      "cwd": ".",
      "command": "node",
      "args": [
        "./dist/server.js"
      ],
      "env_vars": [
        "GROK_BIN",
        "GROK_PLUGIN_STATE_DIR",
        "HOME",
        "PATH",
        "XDG_STATE_HOME",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
        "NODE_EXTRA_CA_CERTS"
      ]
    }
  }
}
